# ─────────────────────────────────────────────────────────────
# 루트 .env.example — 실제 값은 .env(로컬) / 각 플랫폼 대시보드(배포)에 둔다.
# 배포 시크릿은 절대 커밋하지 않는다.
# ─────────────────────────────────────────────────────────────

# ── apps/api (Cloudflare Workers) ────────────────────────────
# Neon 대시보드 > Connection Details > "Pooled connection" 문자열
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/blogyu?sslmode=require"

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Authorization callback URL: https://<api-도메인>/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 어드민 접근을 허용할 GitHub 로그인 아이디 (쉼표 구분)
ADMIN_GITHUB_LOGINS="wjsrbgus04"

# 세션 쿠키 서명 키 — openssl rand -base64 32
AUTH_SECRET=""

# 글 발행 시 Next.js ISR 재검증을 트리거하는 공유 시크릿
REVALIDATE_SECRET=""

# ── apps/web (Vercel) ────────────────────────────────────────
# 브라우저에 노출되는 값이므로 공개 가능한 것만 둔다
NEXT_PUBLIC_API_URL="http://localhost:8787"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Giscus — https://giscus.app 에서 리포지토리 연결 후 발급
NEXT_PUBLIC_GISCUS_REPO="wjsrbgus04/tech-blogyu"
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY="Comments"
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# 서버 전용 — ISR 재검증 엔드포인트가 검증하는 값 (API와 동일해야 함)
REVALIDATE_SECRET=""
