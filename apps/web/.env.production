# 배포 빌드가 쓰는 값. NEXT_PUBLIC_* 는 빌드 시점에 코드로 박히므로
# 런타임 변수(wrangler secret / vars)로는 바꿀 수 없다 — 반드시 여기에 둔다.
#
# apps/api/wrangler.jsonc 의 SITE_URL·MEDIA_BASE_URL 과 짝을 맞춘다.
# 커스텀 도메인을 붙이면 양쪽을 같이 바꾼다.
NEXT_PUBLIC_API_URL="https://blogyu-api.tech-blogyu.workers.dev"
NEXT_PUBLIC_SITE_URL="https://blogyu-web.tech-blogyu.workers.dev"

# giscus 식별자. 클라이언트에 노출되는 공개 값이라 커밋해도 안전하다.
NEXT_PUBLIC_GISCUS_REPO="wjsrbgus04/tech-blogyu"
NEXT_PUBLIC_GISCUS_REPO_ID="R_kgDOUFkxyQ"
NEXT_PUBLIC_GISCUS_CATEGORY="Announcements"
NEXT_PUBLIC_GISCUS_CATEGORY_ID="DIC_kwDOUFkxyc4DESXp"

# 검색엔진 소유 확인 값. 각 콘솔에서 발급받아 채운다 — 비워두면 메타태그가 나가지 않는다.
#   Google  : Search Console > URL 접두어 속성 > HTML 태그 > content 값
#   네이버  : 서치어드바이저 > 사이트 등록 > HTML 태그 > content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""
