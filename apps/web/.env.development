# 로컬 개발(next dev)이 쓰는 값.
#
# 여기와 .env.production 을 나눠 둔 이유: .env.local 은 두 경우 모두에서
# 읽히고 우선순위도 더 높다. URL 을 .env.local 에 두면 배포 빌드에까지
# localhost 가 박혀 나간다. 그래서 URL 은 환경별 파일에만 둔다.
NEXT_PUBLIC_API_URL="http://localhost:8787"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# giscus 식별자. 클라이언트에 노출되는 공개 값이라 커밋해도 안전하다.
NEXT_PUBLIC_GISCUS_REPO="wjsrbgus04/tech-blogyu"
NEXT_PUBLIC_GISCUS_REPO_ID="R_kgDOUFkxyQ"
NEXT_PUBLIC_GISCUS_CATEGORY="Announcements"
NEXT_PUBLIC_GISCUS_CATEGORY_ID="DIC_kwDOUFkxyc4DESXp"

# 로컬에서는 소유 확인이 필요 없다. 배포 값은 .env.production 에 있다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""
