{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blogyu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: @neondatabase/serverless 가 node:buffer 등을 참조한다
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      // 본문 이미지·커버 이미지 저장소. 대시보드에서 같은 이름으로 먼저 만들어야 한다.
      "binding": "MEDIA",
      "bucket_name": "blogyu-media"
    }
  ],
  // ─────────────────────────────────────────────────────────────────
  // 여기 값은 "배포 기준"이다. `wrangler deploy` 가 이 값을 그대로 올린다.
  //
  // 로컬 개발에서는 .dev.vars 가 같은 이름의 값을 덮어쓴다(wrangler 규칙).
  // 그래서 localhost 는 .dev.vars 에만 두고 여기엔 두지 않는다 —
  // 반대로 하면 배포 시 SITE_URL 이 localhost 로 나가면서
  // CORS 거부·OAuth 리다이렉트 실패·재검증 웹훅 실패가 한꺼번에 터진다.
  //
  //    web 쪽 apps/web/.env.production 의 값과 반드시 짝을 맞춘다.
  //    커스텀 도메인을 붙이면 양쪽을 같이 바꾼다.
  // ─────────────────────────────────────────────────────────────────
  "vars": {
    // 비밀이 아닌 값만 여기 둔다. 시크릿은 `wrangler secret put` 으로 넣는다.
    "ADMIN_GITHUB_LOGINS": "wjsrbgus04",
    // blogyu-web 워커의 오리진. CORS 허용·OAuth 리다이렉트·재검증 웹훅에 쓴다.
    "SITE_URL": "https://blogyu-web.jgh10070.workers.dev",
    // 업로드 이미지 URL 앞부분. api 가 /media/* 로 R2 를 중계한다.
    "MEDIA_BASE_URL": "https://blogyu-api.jgh10070.workers.dev/media"
  }
}
